{
  "version": 2,
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/update-maghrib",
      "schedule": "5 19 * * *"
    }
  ]
}
